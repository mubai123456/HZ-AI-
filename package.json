{
  "name": "ai-workbench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "npm run prisma:migrate:deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:db:reset && vitest run",
    "test:db:reset": "node scripts/prepare-test-db.mjs",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "bootstrap:admin": "node prisma/bootstrap-admin.mjs",
    "migrate:sqlite": "node scripts/migrate-sqlite-to-postgres.mjs",
    "deploy:vercel": "node -- scripts/deploy-vercel.mjs",
    "deploy:vercel:preview": "node -- scripts/deploy-vercel.mjs --target preview --env-file .env.vercel",
    "deploy:vercel:preview:dry-run": "node -- scripts/deploy-vercel.mjs --target preview --env-file .env.vercel --dry-run",
    "deploy:vercel:production": "node -- scripts/deploy-vercel.mjs --target production --env-file .env.vercel.production",
    "deploy:vercel:production:dry-run": "node -- scripts/deploy-vercel.mjs --target production --env-file .env.vercel.production --dry-run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/lib-storage": "^3.1014.0",
    "@aws-sdk/s3-request-presigner": "^3.1014.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.2",
    "lucide-react": "^0.577.0",
    "next": "16.2.0",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yazl": "^3.3.0",
    "better-sqlite3": "^12.8.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "jsdom": "^29.0.0",
    "prisma": "^7.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
